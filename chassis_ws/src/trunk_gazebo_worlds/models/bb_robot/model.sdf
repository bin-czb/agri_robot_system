<sdf version='1.9'>
  <model name='bb_robot'>
    <!-- Base link: body mesh -->
    <link name='body'>
      <inertial>
        <mass>300.0</mass>
        <inertia>
          <ixx>313.8</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>217.0</iyy>
          <iyz>0</iyz>
          <izz>447.8</izz>
        </inertia>
      </inertial>
      <visual name='body_visual'>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>meshes/body.STL</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>0.75 0.75 0.75 1</diffuse>
          <ambient>0.75 0.75 0.75 1</ambient>
        </material>
      </visual>
      <collision name='body_collision'>
        <!-- Keep body collision high to avoid scraping ground -->
        <pose>0 0 0.3 0 0 0</pose>
        <geometry>
          <box>
            <size>2.5 1.4 0.4</size>
          </box>
        </geometry>
      </collision>
    </link>

    <!-- Camera body (visual only) -->
    <link name='camera_body'>
      <pose relative_to='body'>1.1775 0.00027 0.383 0 0 0</pose>
      <visual name='camera_body_visual'>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>meshes/camera_body.STL</uri>
          </mesh>
        </geometry>
      </visual>
    </link>
    <joint name='camera_joint' type='fixed'>
      <parent>body</parent>
      <child>camera_body</child>
    </joint>

    <link name="camera_optical_frame">
      <pose relative_to="camera_body">0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0001</iyy><iyz>0</iyz><izz>0.0001</izz>
        </inertia>
      </inertial>
      <sensor name="camera" type="camera">
        <pose>0 0 0 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <topic>/camera/image_raw</topic>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
        </camera>
      </sensor>

      <!-- Depth camera removed: current row-offset mode uses pseudo-distance from image centerpoints (no depth required). -->
    </link>
    <joint name="camera_optical_joint" type="fixed">
      <parent>camera_body</parent>
      <child>camera_optical_frame</child>
    </joint>

    <!-- Left Wheel/Sprocket (Simulated as a wheel for reliable movement) -->
    <link name='left_track'>
      <pose relative_to='body'>0.942 0.61468 0.023 0 0 0</pose>
      <inertial>
        <mass>5.0</mass>
        <inertia>
          <ixx>0.1</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.1</iyy>
          <iyz>0</iyz>
          <izz>0.1</izz>
        </inertia>
      </inertial>
      <visual name='left_track_visual'>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>meshes/wheel2_body.STL</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>0.2 0.2 0.2 1</diffuse>
          <ambient>0.2 0.2 0.2 1</ambient>
        </material>
      </visual>
      <collision name='left_track_collision'>
        <!-- Use a cylinder or sphere for smooth rolling -->
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.2</radius>
            <length>0.2</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>
    <!-- Revolute joint for DiffDrive -->
    <joint name='left_motor_joint' type='revolute'>
      <parent>body</parent>
      <child>left_track</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <!-- No limits for continuous rotation -->
          <lower>-1.0e16</lower>
          <upper>1.0e16</upper>
        </limit>
      </axis>
    </joint>

    <!-- Right Wheel/Sprocket -->
    <link name='right_track'>
      <pose relative_to='body'>0.942 -0.61448 0.023 0 0 0</pose>
      <inertial>
        <mass>5.0</mass>
        <inertia>
          <ixx>0.1</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.1</iyy>
          <iyz>0</iyz>
          <izz>0.1</izz>
        </inertia>
      </inertial>
      <visual name='right_track_visual'>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>meshes/wheel1_body.STL</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>0.2 0.2 0.2 1</diffuse>
          <ambient>0.2 0.2 0.2 1</ambient>
        </material>
      </visual>
      <collision name='right_track_collision'>
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.2</radius>
            <length>0.2</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>
    <joint name='right_motor_joint' type='revolute'>
      <parent>body</parent>
      <child>right_track</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1.0e16</lower>
          <upper>1.0e16</upper>
        </limit>
      </axis>
    </joint>

    <!-- [FIX] 添加后部支撑万向轮 (Caster Wheel) 防止后沉 -->
    <link name='caster_wheel'>
      <pose relative_to='body'>-1.0 0 -0.15 0 0 0</pose>
      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.01</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.01</iyy>
          <iyz>0</iyz>
          <izz>0.01</izz>
        </inertia>
      </inertial>
      <collision name='caster_collision'>
        <geometry>
          <sphere>
            <radius>0.15</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.0</mu> <!-- 无摩擦，方便转向 -->
              <mu2>0.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name='caster_visual'>
        <geometry>
          <sphere>
            <radius>0.15</radius>
          </sphere>
        </geometry>
        <material>
          <diffuse>0 0 0 1</diffuse> <!-- 黑色 -->
        </material>
      </visual>
    </link>
    <joint name='caster_joint' type='fixed'>
      <parent>body</parent>
      <child>caster_wheel</child>
    </joint>

    <!-- DiffDrive Plugin: Robust, proven movement -->
    <plugin
      filename="ignition-gazebo-diff-drive-system"
      name="ignition::gazebo::systems::DiffDrive">
      <left_joint>left_motor_joint</left_joint>
      <right_joint>right_motor_joint</right_joint>
      <wheel_separation>1.229</wheel_separation>
      <wheel_radius>0.2</wheel_radius>
      <odom_publish_frequency>20</odom_publish_frequency>
      <topic>/model/bb_robot/cmd_vel</topic>
      <odom_topic>/model/bb_robot/odometry</odom_topic>
      <tf_topic>/model/bb_robot/tf</tf_topic>
      <frame_id>bb_robot/odom</frame_id>
      <child_frame_id>bb_robot/base_link</child_frame_id>
    </plugin>
  </model>
</sdf>
