<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="orchard_world">
    <!-- Basic lighting / physics -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.85 0.9 1 1</background>
    </scene>

    <!-- Sun -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.2 0.2 -1</direction>
    </light>

    <!-- Ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>200 200</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>200 200</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.25 0.35 0.25 1</ambient>
            <diffuse>0.25 0.45 0.25 1</diffuse>
            <specular>0.01 0.01 0.01 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!--
      Orchard grid: 2 rows x 12 trees (easy to start; tune later)
      Spacing: along row = 6m, between rows = 6m

      Default: use local lightweight trunk model for reliability (offline-friendly, fast load).
      If you want the official Fuel model "Pine Tree", use orchard_pine_fuel.sdf instead.
    -->

    <!-- Row 1 (y = -3) -->
    <include>
      <name>pine_r1_00</name>
      <pose>-33 -3 0 0 0 0</pose>
      <uri>model://simple_tree</uri>
    </include>
    <include>
      <name>pine_r1_01</name>
      <pose>-27 -3 0 0 0 0</pose>
      <uri>model://simple_tree</uri>
    </include>
    <include>
