#!/usr/bin/env bash

set -Eeuo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-${HOME}/.config}/agri_rtk"
CREDENTIAL_FILE="${CONFIG_DIR}/ntrip.env"

read -r -p "请输入 NTRIP 账号: " username
read -r -s -p "请输入 NTRIP 密码: " password
printf '\n'

if [[ -z "${username}" || -z "${password}" ]]; then
  echo "错误: 账号和密码不能为空。" >&2
  exit 1
fi

mkdir -p "${CONFIG_DIR}"
chmod 700 "${CONFIG_DIR}"
umask 077

temporary_file="$(mktemp "${CONFIG_DIR}/ntrip.env.XXXXXX")"
trap 'rm -f "${temporary_file}"' EXIT
{
  printf 'NTRIP_USERNAME=%q\n' "${username}"
  printf 'NTRIP_PASSWORD=%q\n' "${password}"
} > "${temporary_file}"
chmod 600 "${temporary_file}"
mv "${temporary_file}" "${CREDENTIAL_FILE}"
trap - EXIT

echo "NTRIP 凭据已安全保存到: ${CREDENTIAL_FILE}"
echo "文件权限: $(stat -c '%a' "${CREDENTIAL_FILE}")"
