Panels:
  - Class: rviz_common/Displays
    Name: 显示
  - Class: rviz_common/Views
    Name: 视图
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.35
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 115; 120; 125
      Enabled: true
      Name: 地图米制网格
      Plane: XY
      Plane Cell Count: 40
      Reference Frame: map
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/Map
      Color Scheme: map
      Draw Behind: true
      Enabled: true
      Name: 正射处理占据地图
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map
      Update Topic:
        Value: ""
      Use Timestamp: false
      Value: true
    - Alpha: 0.65
      Class: rviz_default_plugins/Map
      Color Scheme: map
      Draw Behind: false
      Enabled: false
      Name: VSLAM完整栅格（含未知区）
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /rtabmap/grid_map
      Update Topic:
        Value: ""
      Use Timestamp: false
      Value: false
    - Alpha: 0.95
      Class: rviz_default_plugins/GridCells
      Color: 220; 45; 35
      Enabled: true
      Name: VSLAM实时障碍栅格
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /rtabmap/occupied_cells
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: 树木与禁入半径
      Namespaces:
        tree_keepout: true
        tree_labels: true
        tree_trunks: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /tree_markers
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/PoseWithCovariance
      Color: 30; 240; 80
      Enabled: false
      Name: RTK当前位置与协方差
      Shape:
        Alpha: 1
        Axes Length: 0.8
        Axes Radius: 0.05
        Color: 30; 240; 80
        Head Length: 0.25
        Head Radius: 0.10
        Shaft Length: 0.75
        Shaft Radius: 0.04
        Value: Arrow
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /global_pose/rtk
      Value: false
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 20; 220; 255
      Enabled: true
      Head Diameter: 0.16
      Head Length: 0.12
      Length: 0.25
      Line Style: Lines
      Line Width: 0.07
      Name: RTK移动轨迹
      Offset:
        X: 0
        Y: 0
        Z: 0.08
      Pose Style: None
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /rtk/path
      Value: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: RTK定位点
      Namespaces:
        rtk: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /rtk/marker
      Value: true
    - Class: rtabmap_rviz_plugins/Info
      Enabled: true
      Name: RTAB-Map状态
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /rtabmap/info
    - Alpha: 0.9
      Axis: Z
      Class: rtabmap_rviz_plugins/MapCloud
      Cloud decimation: 4
      Cloud from scan: false
      Cloud max depth (m): 5
      Cloud min depth (m): 0.35
      Cloud voxel size (m): 0.04
      Color Transformer: RGB8
      Download graph: false
      Download map: false
      Download namespace: rtabmap
      Enabled: false
      Filter ceiling (m): 0
      Filter floor (m): 0
      Name: VSLAM三维点云
      Node filtering angle (degrees): 30
      Node filtering radius (m): 0.15
      Position Transformer: XYZ
      Size (Pixels): 2
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /rtabmap/mapData
      Use Fixed Frame: true
      Value: false
    - Class: rtabmap_rviz_plugins/MapGraph
      Enabled: false
      Global loop closure: 255; 60; 60
      Landmark: 0; 200; 100
      Local loop closure: 255; 220; 40
      Merged neighbor: 255; 170; 0
      Name: VSLAM位姿图
      Neighbor: 50; 120; 255
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /rtabmap/mapGraph
      User: 255; 0; 0
      Value: false
      Virtual: 255; 0; 255
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 70; 255; 130
      Enabled: true
      Head Diameter: 0.10
      Head Length: 0.10
      Length: 0.20
      Line Style: Lines
      Line Width: 0.05
      Name: VSLAM估计轨迹
      Offset:
        X: 0
        Y: 0
        Z: 0.12
      Pose Style: None
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /rtabmap/mapPath
      Value: true
    - Class: rviz_default_plugins/Odometry
      Color: 255; 180; 40
      Enabled: true
      Keep: 1
      Name: VSLAM当前里程计
      Position Tolerance: 0.1
      Angle Tolerance: 0.1
      Shape: Arrow
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /rtabmap/odom
    - Alpha: 0.8
      Class: rviz_default_plugins/RobotModel
      Collision Enabled: false
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Enabled: true
      Name: 机器人模型
      TF Prefix: ""
      Update Interval: 0
      Visual Enabled: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 255; 70; 40
      Enabled: true
      Line Style: Lines
      Line Width: 0.08
      Name: Nav2全局规划路线
      Offset:
        X: 0
        Y: 0
        Z: 0.16
      Pose Style: None
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /plan
      Value: true
    - Alpha: 0.25
      Class: rviz_default_plugins/Map
      Color Scheme: costmap
      Draw Behind: false
      Enabled: false
      Name: Nav2全局代价地图
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /global_costmap/costmap
      Update Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /global_costmap/costmap_updates
      Use Timestamp: false
      Value: false
    - Alpha: 0.7
      Class: rviz_default_plugins/Map
      Color Scheme: costmap
      Draw Behind: false
      Enabled: false
      Name: Nav2局部代价地图
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /local_costmap/costmap
      Update Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /local_costmap/costmap_updates
      Use Timestamp: false
      Value: false
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 40; 130; 255
      Enabled: true
      Head Diameter: 0.12
      Head Length: 0.10
      Length: 0.20
      Line Style: Lines
      Line Width: 0.08
      Name: Nav2局部规划路径
      Offset:
        X: 0
        Y: 0
        Z: 0.20
      Pose Style: None
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /local_plan
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/Polygon
      Color: 40; 255; 100
      Enabled: true
      Name: 机器人局部足迹
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /local_costmap/published_footprint
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: RGB实时图像
      Normalize Range: true
      Topic:
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /camera/color/image_raw
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: false
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 0.35
      Name: TF诊断
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Tree: {}
      Update Interval: 0
      Value: false
  Enabled: true
  Global Options:
    Background Color: 30; 33; 36
    Fixed Frame: map
    Frame Rate: 12
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /goal_pose
  Views:
    Current:
      Angle: 0
      Class: rviz_default_plugins/TopDownOrtho
      Name: 正射俯视
      Scale: 25
      Target Frame: map
      X: 10.475
      Y: 14.950
Window Geometry:
  Height: 920
  Width: 1500
  X: 40
  Y: 30
