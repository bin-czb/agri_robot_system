Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.35
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 120; 125; 130
      Enabled: true
      Name: Reference Grid
      Plane: XY
      Plane Cell Count: 30
      Reference Frame: <Fixed Frame>
    - Class: rtabmap_rviz_plugins/Info
      Enabled: true
      Name: RTAB-Map Status
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /rtabmap/info
    - Alpha: 1
      Axis: Z
      Class: rtabmap_rviz_plugins/MapCloud
      Cloud decimation: 4
      Cloud from scan: false
      Cloud max depth (m): 5
      Cloud min depth (m): 0.35
      Cloud voxel size (m): 0.03
      Color Transformer: RGB8
      Download graph: false
      Download map: false
      Download namespace: rtabmap
      Enabled: true
      Filter ceiling (m): 0
      Filter floor (m): 0
      Name: Accumulated RGB-D Map
      Node filtering angle (degrees): 30
      Node filtering radius (m): 0.15
      Position Transformer: XYZ
      Size (Pixels): 2
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /rtabmap/mapData
      Use Fixed Frame: true
    - Class: rtabmap_rviz_plugins/MapGraph
      Enabled: false
      Global loop closure: 255; 60; 60
      Landmark: 0; 200; 100
      Local loop closure: 255; 220; 40
      Merged neighbor: 255; 170; 0
      Name: Pose Graph and Loop Closures
      Neighbor: 50; 120; 255
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /rtabmap/mapGraph
      User: 255; 0; 0
      Value: false
      Virtual: 255; 0; 255
    - Alpha: 0.55
      Class: rviz_default_plugins/Map
      Color Scheme: map
      Draw Behind: true
      Enabled: false
      Name: Navigation Occupancy Grid
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map
      Update Topic:
        Value: ""
      Use Timestamp: false
      Value: false
    - Class: rviz_default_plugins/Path
      Color: 40; 220; 120
      Enabled: true
      Head Diameter: 0.08
      Head Length: 0.12
      Length: 0.2
      Line Style: Lines
      Line Width: 0.03
      Name: Estimated Trajectory
      Offset:
        X: 0
        Y: 0
        Z: 0.04
      Pose Style: None
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /rtabmap/mapPath
    - Alpha: 1
      Class: rviz_default_plugins/LaserScan
      Color: 255; 170; 40
      Color Transformer: FlatColor
      Enabled: false
      Name: Depth Fake Scan
      Size (Pixels): 3
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /scan
      Value: false
    - Class: rviz_default_plugins/Odometry
      Color: 50; 190; 255
      Enabled: true
      Keep: 1
      Name: Visual Odometry
      Position Tolerance: 0.1
      Angle Tolerance: 0.1
      Shape: Arrow
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /rtabmap/odom
    - Alpha: 0.85
      Class: rviz_default_plugins/RobotModel
      Collision Enabled: false
      Description File: ""
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Enabled: true
      Name: Robot Model
      TF Prefix: ""
      Update Interval: 0
      Visual Enabled: true
    - Class: rviz_default_plugins/TF
      Enabled: false
      Frame Timeout: 15
      Marker Scale: 0.35
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Update Interval: 0
      Value: false
    - Class: rviz_default_plugins/Image
      Enabled: false
      Name: Optional RGB Image
      Normalize Range: true
      Topic:
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /camera/color/image_raw
  Enabled: true
  Global Options:
    Background Color: 32; 35; 38
    Fixed Frame: map
    Frame Rate: 8
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 6
      Focal Point:
        X: 0
        Y: 0
        Z: 0.5
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Mapping Orbit
      Near Clip Distance: 0.01
      Pitch: 0.65
      Target Frame: bb_robot/base_link
      Yaw: 3.14
Window Geometry:
  Height: 900
  Width: 1440
  X: 60
  Y: 40
