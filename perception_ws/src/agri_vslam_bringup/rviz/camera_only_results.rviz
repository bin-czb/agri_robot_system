Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Plane: XY
      Reference Frame: map
    - Class: rviz_default_plugins/Map
      Enabled: true
      Name: RTAB-Map Occupancy Grid
      Topic:
        Value: /map
      Alpha: 0.75
      Draw Behind: false
      Color Scheme: map
    - Class: rviz_default_plugins/LaserScan
      Enabled: true
      Name: Depth Fake Scan
      Topic:
        Value: /scan
      Style: Points
      Size (Pixels): 4
      Color Transformer: FlatColor
      Color: 255; 170; 40
      Alpha: 1
    - Class: rviz_default_plugins/Odometry
      Enabled: true
      Name: RTAB-Map Odometry
      Topic:
        Value: /rtabmap/odom
      Shape: Arrow
      Color: 60; 190; 255
      Position Tolerance: 0.1
      Angle Tolerance: 0.1
      Keep: 200
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Show Axes: true
      Show Names: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: false
      Name: Optional Depth PointCloud
      Topic:
        Value: /camera/depth_registered/points
      Style: Points
      Size (Pixels): 1
      Color Transformer: FlatColor
      Color: 180; 220; 255
      Alpha: 1
      Decay Time: 0
    - Class: rviz_default_plugins/Image
      Enabled: false
      Name: Optional Color Image
      Topic:
        Value: /camera/color/image_raw
      Normalize Range: true
  Enabled: true
  Global Options:
    Fixed Frame: map
    Frame Rate: 8
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 7
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Orbit
      Pitch: 1.5708
      Target Frame: bb_robot/base_link
      Yaw: 0
Window Geometry:
  Height: 900
  Width: 1400
  X: 80
  Y: 60
